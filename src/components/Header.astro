---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { NAV, SITE } from '../site.config';
import { url } from '../utils';
const path = Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ''), '') || '/';
const isActive = (href: string) => path === href || path.startsWith(href);
---
<header class="site-header">
  <div class="wrap nav">
    <a class="brand" href={url('/')} aria-label={`${SITE.name} home`}><Logo /></a>
    <div class="nav-right">
      <ul class="menu" id="menu">
        {NAV.map((n) => (
          <li><a href={url(n.href)} aria-current={isActive(n.href) ? 'page' : undefined}>{n.label}</a></li>
        ))}
        <li><a class="btn btn-red" href={url('/contact/')}>Contact</a></li>
      </ul>
      <button class="icon-btn theme-toggle" type="button" aria-label="Toggle dark mode">
        <span class="i-sun"><Icon name="sun" size={20} /></span><span class="i-moon"><Icon name="moon" size={20} /></span>
      </button>
      <button class="icon-btn burger" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="menu"><Icon name="menu" size={24} /></button>
    </div>
  </div>
</header>
<style>
  .site-header{position:sticky;top:0;z-index:30;background:var(--navy-800);color:#fff;border-bottom:1px solid rgba(255,255,255,.08)}
  .nav{display:flex;align-items:center;justify-content:space-between;height:72px;gap:16px}
  .brand{text-decoration:none}
  .nav-right{display:flex;align-items:center;gap:4px}
  .menu{display:flex;gap:2px;list-style:none;align-items:center}
  .menu a{text-decoration:none;font-size:.93rem;font-weight:500;padding:8px 12px;border-radius:6px;color:var(--on-dark);display:block}
  .menu a:not(.btn):hover{background:rgba(255,255,255,.08)}
  .menu a[aria-current="page"]{color:#fff;box-shadow:inset 0 -2px 0 var(--red);border-radius:0}
  .menu .btn{padding:9px 16px;margin-left:8px;color:#fff}
  .icon-btn{background:none;border:0;color:var(--on-dark);cursor:pointer;padding:8px;border-radius:6px;display:grid;place-items:center}
  .icon-btn:hover{background:rgba(255,255,255,.08)}
  .burger{display:none}
  .i-moon{display:none}
  :global(:root[data-theme="dark"]) .i-sun{display:none}
  :global(:root[data-theme="dark"]) .i-moon{display:block}
  @media (max-width:1040px){
    .menu{display:none;position:absolute;top:72px;left:0;right:0;background:var(--navy-800);flex-direction:column;align-items:stretch;padding:12px 16px 20px;border-bottom:1px solid rgba(255,255,255,.1)}
    .menu.open{display:flex}
    .menu a{padding:12px}
    .menu a[aria-current="page"]{box-shadow:inset 3px 0 0 var(--red)}
    .menu .btn{margin:8px 0 0;justify-content:center}
    .burger{display:grid}
  }
</style>
<script>
  const burger = document.querySelector<HTMLButtonElement>('.burger');
  const menu = document.getElementById('menu');
  burger?.addEventListener('click', () => {
    const open = menu!.classList.toggle('open');
    burger.setAttribute('aria-expanded', String(open));
  });
  document.querySelector('.theme-toggle')?.addEventListener('click', () => {
    const root = document.documentElement;
    const dark = root.dataset.theme
      ? root.dataset.theme === 'dark'
      : matchMedia('(prefers-color-scheme: dark)').matches;
    root.dataset.theme = dark ? 'light' : 'dark';
    try { localStorage.setItem('theme', root.dataset.theme); } catch {}
  });
</script>
