---
import type { CollectionEntry } from 'astro:content';
import Cover from './Cover.astro';
import { url, formatDate } from '../utils';
interface Props { post: CollectionEntry<'news'>; large?: boolean }
const { post, large = false } = Astro.props;
const d = post.data;
---
<a class="card" href={url(`/news/${post.id}/`)}>
  <div class="card-img"><Cover variant={d.cover} seed={post.id} /></div>
  <div class="card-body">
    <span class="tag">{d.type}</span>
    <h3 style={large ? 'font-size:1.45rem' : ''}>{d.title}</h3>
    <p>{d.summary}</p>
    <span class="meta">{formatDate(d.date, { year: 'numeric', month: 'short' })}{d.eventDate && ` · Event: ${d.eventDate}`}</span>
  </div>
</a>
