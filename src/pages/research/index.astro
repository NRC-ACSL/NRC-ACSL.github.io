---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Icon from '../../components/Icon.astro';
import { getCollection } from 'astro:content';
import { url } from '../../utils';
const areas = (await getCollection('areas')).sort((a, b) => a.data.order - b.data.order);
const projects = await getCollection('projects');
const pubs = await getCollection('publications');
const featured = projects.filter((p) => p.data.featured);
const areaTitle = Object.fromEntries(areas.map((a) => [a.id, a.data.title]));
---
<Base title="Research" description="Our research areas, project portfolio and open-source tools.">
  <PageHero eyebrow="Research" title="Research portfolio" intro="Four connected research areas, each with active projects, open tools and publications." crumbs={[{ label: 'Research', href: '/research/' }]}>
    <div class="sub-nav">
      <a class="btn btn-red" href={url('/research/projects/')}>All projects</a>
      <a class="btn btn-ghost" href={url('/research/tools/')}>Tools &amp; datasets</a>
      <a class="btn btn-ghost" href={url('/publications/')}>Publications</a>
    </div>
  </PageHero>

  <section>
    <div class="wrap">
      <div class="sec-head"><div><span class="eyebrow">Research areas</span><h2>What we study</h2></div></div>
      <div class="grid grid-2">
        {areas.map((a) => {
          const nP = projects.filter((p) => p.data.area.id === a.id).length;
          const nPub = pubs.filter((p) => p.data.area?.id === a.id).length;
          return (
            <a class="card" href={url(`/research/areas/${a.id}/`)}>
              <div class="card-body">
                <div class="icon-box"><Icon name={a.data.icon} /></div>
                <h3 style="margin-top:8px">{a.data.title}</h3>
                <p>{a.data.description}</p>
                <span class="meta">{nP} project{nP !== 1 && 's'} · {nPub} publication{nPub !== 1 && 's'}</span>
              </div>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <section class="alt">
    <div class="wrap">
      <div class="sec-head"><div><span class="eyebrow">Featured projects</span><h2>Flagship work</h2></div><a class="link" href={url('/research/projects/')}><span class="arrow">All projects</span></a></div>
      <div class="grid grid-3">
        {featured.map((p) => (
          <a class="card" href={url(`/research/projects/${p.id}/`)}>
            <div class="card-body">
              <div class="row"><span class={`pill status-${p.data.status}`}>{p.data.status}</span><span class="pill">{areaTitle[p.data.area.id]}</span></div>
              <h3>{p.data.title}</h3>
              <p>{p.data.summary}</p>
              <span class="meta">Since {p.data.start}</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>
<style>.sub-nav{display:flex;gap:12px;flex-wrap:wrap;margin-top:28px}</style>
