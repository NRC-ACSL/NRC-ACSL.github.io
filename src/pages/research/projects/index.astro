---
import Base from '../../../layouts/Base.astro';
import PageHero from '../../../components/PageHero.astro';
import { getCollection } from 'astro:content';
import { url } from '../../../utils';
const areas = (await getCollection('areas')).sort((a, b) => a.data.order - b.data.order);
const areaTitle = Object.fromEntries(areas.map((a) => [a.id, a.data.title]));
const rank = { Active: 0, Planned: 1, Completed: 2 };
const projects = (await getCollection('projects')).sort((a, b) => rank[a.data.status] - rank[b.data.status] || b.data.start - a.data.start);
const people = await getCollection('people');
const nameOf = Object.fromEntries(people.map((p) => [p.id, p.data.name]));
---
<Base title="Projects" description="Our research project portfolio.">
  <PageHero eyebrow="Research" title="Project portfolio" intro="Current and past research projects across our four research areas." crumbs={[{ label: 'Research', href: '/research/' }, { label: 'Projects', href: '/research/projects/' }]} />
  <section>
    <div class="wrap">
      <div class="filters">
        <div class="chips" role="group" aria-label="Filter by status">
          {['All', 'Active', 'Completed', 'Planned'].map((s, i) => <button class="chip" type="button" data-status={s} aria-pressed={i === 0 ? 'true' : 'false'}>{s}</button>)}
        </div>
        <select id="area" aria-label="Filter by research area">
          <option value="">All research areas</option>
          {areas.map((a) => <option value={a.id}>{a.data.title}</option>)}
        </select>
      </div>
      <p class="count" id="count"></p>
      <div class="grid grid-3" id="projects">
        {projects.map((p) => (
          <a class="card project" href={url(`/research/projects/${p.id}/`)} data-status={p.data.status} data-area={p.data.area.id}>
            <div class="card-body">
              <div class="row"><span class={`pill status-${p.data.status}`}>{p.data.status}</span><span class="pill">{areaTitle[p.data.area.id]}</span></div>
              <h3>{p.data.title}</h3>
              <p>{p.data.summary}</p>
              <span class="meta">{p.data.start}{p.data.end ? `–${p.data.end}` : '–present'}{p.data.lead && ` · Lead: ${nameOf[p.data.lead.id]}`}</span>
            </div>
          </a>
        ))}
      </div>
      <p class="empty" id="empty">No projects match these filters.</p>
    </div>
  </section>
</Base>
<script>
  const chips = document.querySelectorAll<HTMLButtonElement>('.chip');
  const area = document.getElementById('area') as HTMLSelectElement;
  const cards = document.querySelectorAll<HTMLElement>('.project');
  let status = 'All';
  const params = new URLSearchParams(location.search);
  if (params.get('area')) area.value = params.get('area')!;
  function apply() {
    let n = 0;
    cards.forEach((c) => {
      const show = (status === 'All' || c.dataset.status === status) && (!area.value || c.dataset.area === area.value);
      c.style.display = show ? '' : 'none'; if (show) n++;
    });
    document.getElementById('count')!.textContent = `${n} project${n === 1 ? '' : 's'}`;
    document.getElementById('empty')!.style.display = n ? 'none' : 'block';
  }
  chips.forEach((c) => c.addEventListener('click', () => {
    chips.forEach((x) => x.setAttribute('aria-pressed', 'false'));
    c.setAttribute('aria-pressed', 'true'); status = c.dataset.status!; apply();
  }));
  area.addEventListener('change', apply);
  apply();
</script>
