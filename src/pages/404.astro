---
import Base from '../layouts/Base.astro';
import { url } from '../utils';
---
<Base title="Page not found">
  <section style="padding:120px 0;text-align:center">
    <div class="wrap">
      <p class="eyebrow">Error 404</p>
      <h1 style="font-size:clamp(2rem,5vw,3rem);margin:12px 0">Page not found</h1>
      <p style="color:var(--muted);margin-bottom:28px">The page you're looking for doesn't exist or has moved.</p>
      <a class="btn btn-red" href={url('/')}>Back to home</a>
    </div>
  </section>
</Base>
