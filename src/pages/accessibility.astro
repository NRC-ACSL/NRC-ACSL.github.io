---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
---
<Base title="Accessibility">
  <PageHero title="Accessibility" intro="Our commitment to an accessible website." crumbs={[{ label: 'Accessibility', href: '/accessibility/' }]} />
  <section><div class="wrap"><div class="prose">
<p>We aim to meet the Web Content Accessibility Guidelines (WCAG) 2.1 at level AA. The site supports keyboard navigation, screen readers, dark mode and mobile devices.</p>
<p>If you have trouble using any part of this site, please <a href="../contact/">contact us</a>.</p>
  </div></div></section>
</Base>
